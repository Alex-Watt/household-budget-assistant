# Placeholders fail validation on purpose; copy real values from Discord before deploying.
DISCORD_APPLICATION_ID=replace-with-application-id
# The application's public key (64 hex characters); public, not a secret.
DISCORD_PUBLIC_KEY=replace-with-application-public-key
DISCORD_GUILD_ID=replace-with-server-id
DISCORD_CHANNEL_ID=replace-with-budget-channel-id
DISCORD_MEMBER_1_ID=replace-with-spouse-1-user-id
# Optional until the second spouse joins. Leave this unset rather than using a placeholder.
# DISCORD_MEMBER_2_ID=
DISCORD_SECRET_NAME=household-budget/discord
LIVE_MESSAGING_ENABLED=false
# The secret's value is the channel webhook URL for the 8 AM report. Never put it in this file.

# Optional features, all off by default. See docs/banking-and-ai-setup.md.
# Plaid card sync. The secret holds Plaid keys and read-only tokens; create it with
# `python scripts/plaid_link.py init`, never by hand and never in this file.
PLAID_ENABLED=false
PLAID_SECRET_NAME=household-budget/plaid
# Claude Sonnet answers through Amazon Bedrock (the highest Sonnet the account can call).
AI_ENABLED=false
AI_DAILY_LIMIT=30
AI_PROFILE_SCOPE=us
# Email alarms and a monthly cost budget. Leave unset to create none.
# ALERT_EMAIL=you@example.com
# MONTHLY_COST_ALERT_USD=50
